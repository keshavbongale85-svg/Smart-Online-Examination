# Frontend environment variables (Vite).
# Copy to .env for local overrides, or set these in the Vercel dashboard.
#
# Leave BOTH blank for local dev — Vite proxies /api and the socket to
# http://localhost:5000 automatically (see vite.config.js).
#
# For production on Vercel, point them at your deployed backend (Railway):
#   VITE_API_URL=https://your-backend.up.railway.app/api
#   VITE_SOCKET_URL=https://your-backend.up.railway.app

VITE_API_URL=
VITE_SOCKET_URL=
dd